<robot name="static_map1">
  <link name="ground">
    <visual>
      <geometry>
        <box size="30 10 -0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>

  <link name="static_1">
    <visual>
      <geometry>
        <box size="3 5 1"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>

  <joint name="obstacle_1_joint" type="fixed">
    <parent link="ground"/>
    <child link="static_1"/>
    <origin xyz="0 -2.5 0.5"/>
  </joint>
  
  
    <link name="static_2">
    <visual>
      <geometry>
        <box size="2 5 1"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
  
  <joint name="static_1_joint" type="fixed">
    <parent link="ground"/>
    <child link="static_2"/>
    <origin xyz="8 2.5 0.5"/>
  </joint>
  
</robot>

